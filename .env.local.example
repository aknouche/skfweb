# Sanity Configuration
# Copy this file to .env.local and fill in your values

# Get these from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Webhook secret for on-demand revalidation (keep this private)
REVALIDATION_SECRET=your-secret-here

# Resend email configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@svenskakickboxning.se
RESEND_TO_EMAIL=info@svenskakickboxning.se

# Chat widget AI fallback (optional)
# Free-tier key from https://aistudio.google.com/apikey — used only by
# src/app/api/chat/route.ts, server-side. Never prefix with NEXT_PUBLIC_;
# if unset, the chat widget just falls back to its static message instead
# of calling the AI.
GEMINI_API_KEY=your-gemini-api-key-here
